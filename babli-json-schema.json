{
  "$ref": "#/definitions/babli.json schema",
  "definitions": {
    "babli.json schema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "description": "The project ID. You can find it in the project settings."
        },
        "sortBy": {
          "type": "string",
          "enum": [
            "key",
            "value",
            "original"
          ],
          "default": "original",
          "description": "How to sort the keys in the file"
        },
        "defaultFilePattern": {
          "type": "string",
          "description": "HIDDEN"
        },
        "translationFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "The path to the translation file. Use {{lang}} placeholder to define the language code."
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Babli will autodetect languages by default, but in case you need different languages with different languages, you can define the languages here."
              },
              "format": {
                "type": "string",
                "enum": [
                  "json",
                  "yaml",
                  "flutterArb",
                  "typescript",
                  "po"
                ],
                "description": "Babli will autodetect format from file extensions. But if using non-standard extensions, you can change format here."
              },
              "nested": {
                "type": "boolean",
                "default": true,
                "description": "Define if keys should be exported as nested values `{ \"a\": { \"b\": \"x\"}}` or not nested `{ \"a.b\": \"x\" }`"
              },
              "topLevelLanguageCode": {
                "type": "boolean",
                "default": false
              },
              "pullWithEmptyValues": {
                "type": "boolean",
                "default": false
              },
              "yaml": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "default": {}
              },
              "sortBy": {
                "type": "string",
                "enum": [
                  "key",
                  "value",
                  "original"
                ],
                "default": "original"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "description": "Source files for the translations."
        },
        "defaultFile": {
          "type": "string",
          "description": "HIDDEN"
        },
        "host": {
          "type": "string",
          "default": "https://www.babli.ai",
          "description": "HIDDEN"
        },
        "emptyValueString": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "In case you use some specific value to mark the value is not translated yet,\nFor example 'NOT_TRANSLATED', You can define it here."
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "translationFiles"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}